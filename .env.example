# 复制为 .env.local 后填写。不要把 .env.local 提交进仓库。

# 老师登录密码。首次启动时写入数据库，之后改这个值不会自动改已写入的密码。
TEACHER_PASSWORD=

# 会话签名密钥。用一串足够长的随机字符。
SESSION_SECRET=

# 腾讯云 API 密钥。智聆口语评测和语音合成共用。
# https://console.cloud.tencent.com/cam/capi
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# 智聆口语评测（新版）的 AppId，在 API 密钥页账号信息里。
# 开通：https://console.cloud.tencent.com/soenew
TENCENT_SOE_APPID=

# 语音合成音色，默认 101001（智瑜，中文女声）。可不填。
TENCENT_TTS_VOICE_TYPE=101001
